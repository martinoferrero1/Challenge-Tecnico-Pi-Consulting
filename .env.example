APP_NAME="Challenge AI RAG API"
APP_VERSION="0.1.0"
API_PREFIX="/api"

# Documento de ejemplo del challenge.
SOURCE_DOCUMENT_PATH="./data/original_document.docx"
SOURCE_DOCUMENT_IS_DEFAULT=true

# ChromaDB.
CHROMA_PERSIST_DIR=".chroma"
CHROMA_COLLECTION_NAME="challenge_rag"

# Chunking generico. Si SOURCE_DOCUMENT_IS_DEFAULT=true, estos valores no se usan
# para el documento base porque se activa la estrategia por secciones.
TEXT_CHUNK_SIZE=800
TEXT_CHUNK_OVERLAP=120

# Retrieval.
RAG_RETRIEVAL_LIMIT=3

# Conversacion.
# Valores soportados: disabled, prompt, rewrite.
CONVERSATION_CONTEXT_MODE="rewrite"
CONVERSATION_HISTORY_LIMIT=10

# Cache.
# Valores soportados: document_context, question, context_aware.
ANSWER_CACHE_MODE="context_aware"

# Idioma y validacion de respuesta.
LANGUAGE_CONFIDENCE_THRESHOLD=0.15
ANSWER_VALIDATION_RETRIES=1

# Providers soportados para LLM_PROVIDER: openai, cohere, gemini.
# Providers soportados para EMBEDDING_PROVIDER: openai, cohere, gemini.
LLM_PROVIDER="cohere"
EMBEDDING_PROVIDER="cohere"
LLM_TEMPERATURE="0"

# Judge opcional para ANSWER_CACHE_MODE=context_aware.
# Si quedan vacios, usa LLM_PROVIDER y el modelo LLM principal de ese provider.
JUDGE_LLM_PROVIDER=""
JUDGE_LLM_MODEL=""

# OpenAI.
OPENAI_API_KEY="your-openai-api-key"
OPENAI_LLM_MODEL="gpt-5.5"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Cohere.
COHERE_API_KEY="your-cohere-api-key"
COHERE_LLM_MODEL="command-a-03-2025"
COHERE_EMBEDDING_MODEL="embed-v4.0"
COHERE_EMBEDDING_INPUT_TYPE="search_document"

# Gemini.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_LLM_MODEL="gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
